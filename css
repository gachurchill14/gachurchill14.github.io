

:root{
 --navy:#163A63;
 --blue:#2B6EA6;
 --light:#F6F8FA;
 --text:#2A2A2A;
 --max:1100px;
}
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 color:var(--text);
 background:#fff;
 line-height:1.6;
}
header{
 position:sticky;top:0;
 background:#fff;
 border-bottom:1px solid #ddd;
}
nav{
 max-width:var(--max);
 margin:auto;
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:1rem;
}
nav h1{color:var(--navy);margin:0;font-size:1.4rem}
nav ul{display:flex;gap:1rem;list-style:none;padding:0;margin:0}
nav a{text-decoration:none;color:var(--navy);font-weight:bold}
nav a:hover{color:var(--blue)}
main{max-width:var(--max);margin:auto}
section{padding:4rem 1.5rem}
.hero{
 text-align:center;
 background:var(--light);
 padding:6rem 1.5rem;
}
.hero h2{
 font-size:3rem;
 margin:.2rem 0;
 color:var(--navy);
}
.hero p{max-width:700px;margin:1rem auto}
a{
 color:var(--blue);
}
.hero a{
 display:inline-block;
 margin:.5rem;
 padding:.9rem 1.4rem;
 border-radius:6px;
 text-decoration:none;
 border:2px solid var(--blue);
}
.hero a:first-of-type{
 background:var(--blue);
 color:white;
}
.hero a:last-of-type{
 background:white;
}
h2{
 color:var(--navy);
 border-bottom:3px solid var(--blue);
 display:inline-block;
 padding-bottom:.3rem;
}
footer{
 background:var(--navy);
 color:white;
 text-align:center;
 padding:2rem 1rem;
}
footer a{color:white}
@media(max-width:700px){
 nav{flex-direction:column}
 nav ul{flex-wrap:wrap;justify-content:center}
 .hero h2{font-size:2.2rem}
}
